{
  "name": "harness-memory",
  "version": "0.5.1",
  "description": "Project memory layer for coding harnesses",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./activation": {
      "types": "./dist/activation/index.d.ts",
      "import": "./dist/activation/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./dream": {
      "types": "./dist/dream/index.d.ts",
      "import": "./dist/dream/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "harness-memory": "dist/bin/harness-memory.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "project-memory",
    "coding-harness",
    "sqlite",
    "activation",
    "policy"
  ],
  "homepage": "https://github.com/smc2315/harness-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smc2315/harness-memory.git"
  },
  "bugs": {
    "url": "https://github.com/smc2315/harness-memory/issues"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-assets.mjs",
    "package:pack": "npm pack",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:embedding": "vitest run --config vitest.embedding.config.ts"
  },
  "dependencies": {
    "minimatch": "^10.0.1",
    "minisearch": "^7.2.0",
    "sql.js": "^1.8.0"
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@xenova/transformers": "^2.17.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
